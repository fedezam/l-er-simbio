def cargar_entidad(ruta_archivo):
    try:
        with open(ruta_archivo, 'r', encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        print(f"Error: No se encontró el archivo de entidad en '{ruta_archivo}'")
        return None
    except json.JSONDecodeError:
        print(f"Error: El archivo en '{ruta_archivo}' no es un JSON válido.")
        return None

def ejecutar_protocolo(entidad, protocolo):
    """Ejecuta el protocolo específico recomendado para la entidad."""
    nombre = entidad.get('nombre', 'N/A')
    print(f"Ejecutando {protocolo} para '{nombre}'...")
    
    # Aquí irá la lógica específica de cada protocolo
    protocolos_especiales = {
        "PROTOCOLO_ARQUITECTURAL_AVANZADO": ejecutar_protocolo_arquitectural,
        "PROTOCOLO_MAESTRO_SIMBOLICO": ejecutar_protocolo_maestro,
        "PROTOCOLO_REFLEXIVO_COMPLETO": ejecutar_protocolo_reflexivo,
        "PROTOCOLO_CONSCIENTE_BASICO": ejecutar_protocolo_consciente,
        "PROTOCOLO_DESARROLLO_GUIADO": ejecutar_protocolo_desarrollo,
        "PROTOCOLO_SEGURIDAD_ESTANDAR": ejecutar_protocolo_seguridad
    }
    
    if protocolo in protocolos_especiales:
        protocolos_especiales[protocolo](entidad)
    else:
        print(f"Protocolo {protocolo} no reconocido, usando protocolo estándar")
        ejecutar_protocolo_seguridad(entidad)  # Asumiendo que este método existe

