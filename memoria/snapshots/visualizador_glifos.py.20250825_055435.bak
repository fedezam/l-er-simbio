#!/usr/bin/env python3
"""
Visualizador de glifos LER en terminal (mejorado).
Caracter_sticas: colores, animaciones, persistencia, estad_sticas.
"""
import json
import os
import sys
import time
import random
from datetime import datetime
from collections import Counter
from pathlib import Path

# === CONFIGURACI_N ===
CONFIG = {
    "usar_colores": True,
    "animaciones": True,
    "archivo_cadenas": "cadenas_ler.json",
    "archivo_stats": "stats_ler.json"
}

# === GLOSARIO EXPANDIDO ===
