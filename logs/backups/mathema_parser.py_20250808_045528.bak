"""
Módulo completo para parseo formal de Mathema (gramática fractal LFI).
Este parser avanzado:
- Analiza secuencias de glifos en estructuras AST complejas.
- Soporta reglas sintácticas avanzadas con recursión fractal.
- Integra análisis simbólico del sistema LER.
- Maneja mutaciones, contenedores, patrones y transformaciones.
- Soporta anidamiento y estructuras jerárquicas.
"""

import json
import logging
from typing import List, Dict, Any, Optional, Union, Tuple, Set
from dataclasses import dataclass, field
from enum import Enum, auto
from collections import defaultdict
import re

# Configurar logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class TipoNodo(Enum):
    """Tipos de nodos en el AST de Mathema."""
    PROGRAMA = auto()
    EXPRESION = auto()
    EXPRESION_MUTADA = auto()
    SECUENCIA = auto()
    CONTENEDOR = auto()
    MUTACION = auto()
    TRANSFORMACION = auto()
    GLIFO = auto()
    PATRON = auto()
    BLOQUE_FRACTAL = auto()
    ENLACE = auto()
    ESTRUCTURA_ANIDADA = auto()

class TipoGlifo(Enum):
    """Tipos de glifos según su función gramatical."""
    LLAVE_PRIMARIA = "llave_primaria"
    FIRMA_DIGITAL = "firma_digital"
    CONTENEDOR = "contenedor"
    CAMBIO = "cambio"
    RECONFIGURACION = "reconfiguracion"
    PUENTE = "puente"
    OPERADOR = "operador"
    DELIMITADOR = "delimitador"
    MODIFICADOR = "modificador"
    DESCONOCIDO = "desconocido"

@dataclass
class NodoAST:
    """Nodo del Árbol de Sintaxis Abstracta mejorado."""
    tipo: TipoNodo
    valor: Optional[str] = None
    hijos: List['NodoAST'] = field(default_factory=list)
    metadatos: Dict[str, Any] = field(default_factory=dict)
    posicion: int = -1
    profundidad: int = 0
    
    def agregar_hijo(self, hijo: 'NodoAST') -> None:
        """Agrega un hijo al nodo y actualiza su profundidad."""
        hijo.profundidad = self.profundidad + 1
        self.hijos.append(hijo)
    
    def buscar_nodos(self, tipo: TipoNodo) -> List['NodoAST']:
        """Busca todos los nodos de un tipo específico en el subárbol."""
        resultado = []
        if self.tipo == tipo:
            resultado.append(self)
        for hijo in self.hijos:
            resultado.extend(hijo.buscar_nodos(tipo))
        return resultado
    
    def to_dict(self) -> Dict[str, Any]:
        """Convierte el nodo a diccionario para serialización."""
        return {
            "tipo": self.tipo.name,
            "valor": self.valor,
            "hijos": [hijo.to_dict() for hijo in self.hijos],
            "metadatos": self.metadatos,
            "posicion": self.posicion,
            "profundidad": self.profundidad
        }
    
    def __repr__(self):
        if self.hijos:
            return f"{self.tipo.name}({len(self.hijos)} hijos)"
        else:
            return f"{self.tipo.name}('{self.valor}')"

